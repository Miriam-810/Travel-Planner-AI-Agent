# Copy to backend/.env and fill in. Never commit backend/.env.

# Claude model: Haiku 5.5 for development, claude-opus-5-5 for evals and demos
MODEL=claude-haiku-5-5

# Comma-separated browser origins allowed to call the API (only needed after deploy)
CORS_ORIGINS=

# Google Places API (New), server-side key. See docs/GOOGLE_MAPS_SETUP.md, part 2.
# Leave empty to work with the sample trip only.
GOOGLE_PLACES_API_KEY=

# Added in later steps:
# ANTHROPIC_API_KEY=        (step 7)
# INVITE_CODES=             (step 7, comma-separated)
