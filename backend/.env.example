# Copy to backend/.env and fill in. Never commit backend/.env.

# Claude model: Haiku 5.5 for development, claude-opus-5-5 for evals and demos
MODEL=claude-haiku-5-5

# Interactive API docs at /docs. Set to false in production.
ENABLE_DOCS=true

# Comma-separated browser origins allowed to call the API (only needed after deploy)
CORS_ORIGINS=

# Google Places API (New), server-side key. See docs/GOOGLE_PLACES_SETUP.md.
# Leave empty to work with the sample trip only.
GOOGLE_PLACES_API_KEY=

# Anthropic API key for the planning agent. See docs/ANTHROPIC_SETUP.md.
ANTHROPIC_API_KEY=

# Reasoning effort: low | medium | high | xhigh | max
EFFORT=medium

# Invite codes that may generate outlines (comma-separated), and the daily limits
INVITE_CODES=
DAILY_LIMIT_PER_CODE=3
DAILY_LIMIT_SITE=20
# POST /api/trips (building the final itinerary) has its own limits
DAILY_TRIPS_PER_CODE=10
DAILY_TRIPS_SITE=50
